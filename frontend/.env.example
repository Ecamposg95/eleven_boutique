# Base de la API en servidor. También la usa el rewrite /api/v1/* (se fija al compilar).
API_URL=http://localhost:8000/api/v1

# URL pública del sitio: canonical, Open Graph y sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hostnames HTTPS de imágenes remotas que pasan por el optimizador, separados por coma.
# Las imágenes de otros hosts se sirven directo, sin optimizar.
NEXT_PUBLIC_IMAGE_HOSTS=
