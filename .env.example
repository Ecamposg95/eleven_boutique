# Copiar a .env. Este archivo no contiene secretos; los valores de producción se configuran
# en Railway. Nunca exponer secretos al bundle web (solo variables VITE_* llegan al navegador).

# --- Entorno ---
APP_ENV=local                       # local | preview | production
TENANT_SLUG=demo                    # tenant que sirve esta instancia (resuelto en servidor)

# --- Base de datos (compose.yaml expone Postgres en 5433) ---
DB_PORT=5433
DATABASE_URL=postgresql+psycopg://eleven:eleven@localhost:5433/eleven
TEST_DATABASE_URL=postgresql+psycopg://eleven:eleven@localhost:5433/eleven_test

# --- API ---
CORS_ORIGINS=http://localhost:5173
CATALOG_PAGE_MAX=48

# --- Web (públicas, llegan al navegador) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_SITE_URL=http://localhost:5173
VITE_DEMO_MODE=true                 # muestra la banda «Demostración» y noindex

# --- Feature flags ---
DEMO_MODE=true
CATALOG_PUBLIC_ENABLED=true
VISION_PROCESSING_ENABLED=false
WHATSAPP_AUTOREPLY_ENABLED=false
ATLAS_SYNC_ENABLED=false
CHECKOUT_ENABLED=false
PAYMENTS_ENABLED=false

# --- Fases posteriores (sin valores hasta tener accesos autorizados) ---
