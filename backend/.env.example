# Base de datos. SQLite en local; en producción, postgresql+psycopg://...
DATABASE_URL=sqlite:///./eleven.db
# true incluye registros is_demo y marcas no publicadas en las respuestas públicas.
DEMO_MODE=false
# Número de WhatsApp en formato E.164. Vacío: consult_url = null.
WHATSAPP_NUMBER=
# Línea Boutique para las piezas de marcas premium. Vacío: usan WHATSAPP_NUMBER.
WHATSAPP_PREMIUM_NUMBER=
# Base de los enlaces que viajan en el mensaje de WhatsApp.
PUBLIC_SITE_URL=http://localhost:3000
# Orígenes permitidos, separados por comas.
CORS_ORIGINS=http://localhost:3000
# "development" permite la cookie de sesión del panel sin Secure. Cualquier otro valor la exige.
APP_ENV=development
# Carpeta de fotos subidas. Vacío: backend/media/.
MEDIA_ROOT=
# Solo para scripts.create_admin: contraseña sin pedirla por consola. No la dejes aquí.
# ADMIN_PASSWORD=
